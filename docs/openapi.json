{
 "openapi": "3.1.0",
 "info": {
  "title": "MoveMatch API",
  "version": "1.0.0",
  "description": "Core marketplace API (API-01 vertical slice). All monetary values are decimal strings in USD. Totals are always computed by the server."
 },
 "servers": [
  {
   "url": "https://movematchs.vercel.app/api/v1"
  }
 ],
 "components": {
  "securitySchemes": {
   "session": {
    "type": "apiKey",
    "in": "cookie",
    "name": "mm_s",
    "description": "Signed session cookie from POST /api/login (approved accounts only)."
   },
   "admin": {
    "type": "apiKey",
    "in": "cookie",
    "name": "mm_admin"
   }
  },
  "schemas": {
   "Meta": {
    "type": "object",
    "properties": {
     "request_id": {
      "type": "string",
      "format": "uuid"
     },
     "timestamp": {
      "type": "string",
      "format": "date-time"
     }
    }
   },
   "Envelope": {
    "type": "object",
    "properties": {
     "success": {
      "type": "boolean"
     },
     "data": {},
     "meta": {
      "type": "object",
      "properties": {
       "request_id": {
        "type": "string",
        "format": "uuid"
       },
       "timestamp": {
        "type": "string",
        "format": "date-time"
       }
      }
     }
    }
   },
   "Error": {
    "type": "object",
    "properties": {
     "success": {
      "const": false
     },
     "error": {
      "type": "object",
      "properties": {
       "code": {
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "details": {
        "type": "array",
        "items": {
         "type": "object",
         "properties": {
          "field": {
           "type": "string"
          },
          "message": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "meta": {
      "$ref": "#/components/schemas/Meta"
     }
    }
   },
   "ProjectCreate": {
    "type": "object",
    "required": [
     "project_type"
    ],
    "properties": {
     "project_type": {
      "enum": [
       "local",
       "long_distance",
       "interstate",
       "international",
       "commercial"
      ]
     },
     "requested_move_date": {
      "type": "string",
      "format": "date"
     },
     "property_type": {
      "type": "string"
     },
     "home_size": {
      "type": "string"
     },
     "notes": {
      "type": "string",
      "maxLength": 1000
     }
    }
   },
   "Address": {
    "type": "object",
    "required": [
     "address_type",
     "line1",
     "city",
     "region",
     "postal_code"
    ],
    "properties": {
     "address_type": {
      "enum": [
       "origin",
       "destination",
       "intermediate_stop",
       "storage"
      ]
     },
     "line1": {
      "type": "string"
     },
     "city": {
      "type": "string"
     },
     "region": {
      "type": "string",
      "pattern": "^[A-Za-z]{2}$"
     },
     "postal_code": {
      "type": "string",
      "pattern": "^\\d{5}(-\\d{4})?$"
     },
     "floor_number": {
      "type": "string"
     },
     "lift_available": {
      "type": "boolean"
     },
     "access_notes": {
      "type": "string"
     }
    }
   },
   "InventoryItem": {
    "type": "object",
    "required": [
     "room",
     "item_name",
     "quantity"
    ],
    "properties": {
     "room": {
      "type": "string"
     },
     "item_name": {
      "type": "string"
     },
     "quantity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999
     },
     "fragile": {
      "type": "boolean"
     }
    }
   },
   "Quote": {
    "type": "object",
    "required": [
     "estimate_type",
     "items"
    ],
    "properties": {
     "estimate_type": {
      "enum": [
       "binding",
       "non_binding",
       "binding_not_to_exceed"
      ]
     },
     "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
       "type": "object",
       "required": [
        "description",
        "quantity",
        "unit_price"
       ],
       "properties": {
        "description": {
         "type": "string"
        },
        "quantity": {
         "type": "number",
         "exclusiveMinimum": 0
        },
        "unit_price": {
         "type": "string",
         "pattern": "^\\d{1,8}(\\.\\d{1,2})?$"
        }
       }
      }
     },
     "discount_amount": {
      "type": "string"
     },
     "tax_amount": {
      "type": "string"
     },
     "valid_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
     },
     "inclusions": {
      "type": "string"
     },
     "exclusions": {
      "type": "string"
     },
     "terms": {
      "type": "string"
     }
    }
   },
   "Verification": {
    "type": "object",
    "required": [
     "check_type",
     "reference"
    ],
    "properties": {
     "check_type": {
      "enum": [
       "identity",
       "business",
       "operating_authority",
       "insurance"
      ]
     },
     "reference": {
      "type": "string"
     },
     "expires_on": {
      "type": "string",
      "format": "date"
     }
    }
   }
  }
 },
